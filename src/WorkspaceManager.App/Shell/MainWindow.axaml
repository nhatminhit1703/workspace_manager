<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:WorkspaceManager.App.Shell"
        xmlns:modules="using:WorkspaceManager.Core.Modules"
        x:Class="WorkspaceManager.App.Shell.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="{Binding Title}"
        Icon="avares://WorkspaceManager/Assets/app.ico"
        Width="1280" Height="800" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="200,*">
    <!-- Navigation of the active role -->
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="14,16,14,10" Spacing="2">
          <TextBlock Text="Workspace Manager" FontWeight="Bold" FontSize="15" />
          <TextBlock Text="{Binding Role.DisplayName}" Opacity="0.65" FontSize="12" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedItem}"
                 Background="Transparent" Margin="6,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="modules:NavigationItem">
              <TextBlock Text="{Binding Title}" Margin="4,2" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1">
      <!-- New release banner -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding Update.IsVisible}" Background="#1F6FEB" Padding="12,8">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding Update.Message}" Foreground="White" VerticalAlignment="Center" />
            <ProgressBar Value="{Binding Update.Progress}" Maximum="100" Width="120" IsVisible="{Binding Update.IsDownloading}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Content="Update and restart" Command="{Binding Update.InstallCommand}" />
            <Button Content="Later" Command="{Binding Update.DismissCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Current page: the view comes from the ViewRegistry data template -->
      <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
  </Grid>
</Window>
