<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WorkspaceManager.Modules.Pm.Repos"
             x:Class="WorkspaceManager.Modules.Pm.Repos.ReposView"
             x:DataType="vm:ReposViewModel">

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="12,10" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Workspace:" VerticalAlignment="Center" Opacity="0.7" />
          <TextBlock Text="{Binding WorkspaceRoot, FallbackValue='(not set)', TargetNullValue='(not set)'}"
                     FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="Change..." Command="{Binding ChooseWorkspaceCommand}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding Filter}" PlaceholderText="Filter repo or branch" Width="220" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" HotKey="F5" Classes="accent" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Selection helpers -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="12,8,12,0">
      <TextBlock Text="Select:" VerticalAlignment="Center" Opacity="0.7" />
      <Button Content="All" Command="{Binding SelectAllCommand}" CommandParameter="all" />
      <Button Content="None" Command="{Binding SelectAllCommand}" CommandParameter="none" />
      <Button Content="With changes" Command="{Binding SelectAllCommand}" CommandParameter="changes" />
      <Button Content="Behind upstream" Command="{Binding SelectAllCommand}" CommandParameter="behind" />
    </StackPanel>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="12,6" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="100" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Empty state -->
    <StackPanel IsVisible="{Binding !HasWorkspace}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <TextBlock Text="No workspace folder yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="Choose the folder that contains your git repositories." Opacity="0.7" HorizontalAlignment="Center" />
      <Button Content="Choose workspace folder..." Command="{Binding ChooseWorkspaceCommand}" Classes="accent" HorizontalAlignment="Center" />
    </StackPanel>

    <DataGrid x:Name="Grid" IsVisible="{Binding HasWorkspace}" Margin="12,8,12,8"
              ItemsSource="{Binding Repos}" SelectedItem="{Binding SelectedRepo}"
              AutoGenerateColumns="False" CanUserSortColumns="True" CanUserResizeColumns="True"
              IsReadOnly="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}" />
          <MenuItem Header="Open terminal here" Command="{Binding OpenTerminalCommand}" />
          <MenuItem Header="Open in VS Code" Command="{Binding OpenInEditorCommand}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RepoRowViewModel">
              <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Repository" Width="260" MinWidth="160" SortMemberPath="Name">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RepoRowViewModel">
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"
                         Classes.error="{Binding HasError}" ToolTip.Tip="{Binding ToolTip}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Current branch" Width="*" MinWidth="200" SortMemberPath="Branch">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RepoRowViewModel">
              <TextBlock Text="{Binding Branch}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Branch}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Changes" Width="110" SortMemberPath="Changes">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RepoRowViewModel">
              <Border Classes.dirty="{Binding HasChanges}" Padding="8,2" Margin="4" CornerRadius="4" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Changes}" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="vs upstream" Width="150" SortMemberPath="Sync">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RepoRowViewModel">
              <TextBlock Text="{Binding Sync}" VerticalAlignment="Center" Margin="8,0"
                         Classes.behind="{Binding IsBehind}" Classes.ahead="{Binding IsAhead}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Last commit" Binding="{Binding LastCommit, x:DataType=vm:RepoRowViewModel}" Width="140" IsReadOnly="True" />
        <DataGridTextColumn Header="Last fetch" Binding="{Binding LastFetch, x:DataType=vm:RepoRowViewModel}" Width="150" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>

  <UserControl.Styles>
    <Style Selector="Border.dirty">
      <Setter Property="Background" Value="#33F0B429" />
    </Style>
    <Style Selector="TextBlock.behind">
      <Setter Property="Foreground" Value="#D9480F" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#E03131" />
    </Style>
    <Style Selector="TextBlock.ahead">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>
</UserControl>
